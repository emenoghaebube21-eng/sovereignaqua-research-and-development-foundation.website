# SovereignAqua BFF / API environment template
# NEVER put real credentials in this file.
# Store production values in the backend deployment secret manager.

AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=YOUR_CLIENT_ID
AUTH0_CLIENT_SECRET=SERVER_SIDE_ONLY
AUTH0_AUDIENCE=https://api.example.org
AUTH0_SECRET=GENERATE_A_LONG_RANDOM_VALUE
APP_BASE_URL=https://www.example.org

# Database / storage values will be added when the backend is selected.
# DATABASE_URL=
# STORAGE_ENDPOINT=
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
